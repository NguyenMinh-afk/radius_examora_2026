{
  "name": "api-gateway-service",
  "version": "1.0.0",
  "description": "API Gateway - Proxy/routing layer",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "cross-env SERVICE_NAME=api-gateway node src/server.js",
    "dev": "cross-env SERVICE_NAME=api-gateway nodemon src/server.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.7.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
