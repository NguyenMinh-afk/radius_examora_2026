{
  "name": "examora-infrastructure",
  "version": "1.0.0",
  "description": "Infrastructure Service - Queue Consumers, Email Workers, Background Jobs",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env SERVICE_NAME=infrastructure-service nodemon src/server.js",
    "start": "cross-env SERVICE_NAME=infrastructure-service node src/server.js",
    "workers": "node src/workers/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write ."
  },
  "keywords": [
    "examora",
    "infrastructure",
    "rabbitmq",
    "queue"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^0.10.5",
    "axios": "^1.7.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.0",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^2.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.0.0"
  }
}
