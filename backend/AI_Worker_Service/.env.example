# AI Service environment example

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ai_user:ai_password@localhost:5432/ai_service_db
# Docker value:
# DATABASE_URL=postgresql+asyncpg://ai_user:ai_password@postgres:5432/ai_service_db

# --- Gemini ---
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
GEMINI_MIN_INTERVAL_SECONDS=6
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash-lite
ENABLE_MODEL_FALLBACK=true
MAX_SINGLE_CALL_CONTEXT_CHARS=120000
MAX_MERGED_CONTEXT_CHARS=120000
MAX_OUTPUT_TOKENS=32768
GEMINI_DAILY_REQUEST_LIMIT=18
ENABLE_LOCAL_FALLBACK=true
LOCAL_FALLBACK_WHEN_QUOTA_EXCEEDED=true
QUEUE_WHEN_QUOTA_EXCEEDED=false
MAX_QUESTIONS_PER_TASK=50

# --- TopicResolver ---
AUTO_DETECT_TOPIC=true
TOPIC_CATALOG_PATH=app/application/resources/topic_catalog.json
TOPIC_MISMATCH_OVERRIDE=true
MIN_TOPIC_CONFIDENCE=0.75
TOPIC_DETECTION_MAX_CHARS=8000
AUTO_RESOLVE_COURSE_SUBJECT_FROM_TOPIC=true
DEFAULT_COURSE_NAME=Khóa học mặc định
DEFAULT_SUBJECT_NAME=
USE_TOPIC_AS_SUBJECT_NAME=true
USE_TOPIC_AS_COURSE_NAME=false

# --- RabbitMQ ---
USE_RABBITMQ=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Docker value:
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=ai_generation_queue
RABBITMQ_DLQ=ai_generation_dlq
RABBITMQ_MAX_RETRIES=3

# --- Upload ---
MAX_FILE_SIZE_MB=20
RAW_UPLOAD_DIR=./data/raw

# --- OCR local ---
ENABLE_OCR=true
OCR_PROVIDER=auto
OCR_LANGUAGE=vie+eng
OCR_DPI=150
OCR_MAX_PAGES=20
OCR_MIN_TEXT_LENGTH=100
TESSERACT_CMD=
POPPLER_PATH=

# --- OCR.Space ---
# Do not commit a real OCR.Space API key.
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_SPACE_DETECT_ORIENTATION=true
OCR_SPACE_SCALE=true
OCR_SPACE_IS_TABLE=true
OCR_SPACE_TIMEOUT_SECONDS=60
OCR_SPACE_MAX_FILE_MB=1
OCR_SPACE_MAX_PDF_PAGES=3
OCR_SPACE_DAILY_REQUEST_LIMIT=500
OCR_SPACE_HOURLY_REQUEST_LIMIT=180
OCR_SPACE_MONTHLY_REQUEST_LIMIT=25000

# --- Text processing ---
CHUNK_SIZE=6000
CHUNK_OVERLAP=500
