APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:123456@postgres-db:5432/Exam_Bank
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ENABLE_LOCAL_FALLBACK=true
LOCAL_FALLBACK_WHEN_QUOTA_EXCEEDED=true
USE_RABBITMQ=true
RABBITMQ_URL=amqp://admin:StrongPassword123@rabbitmq:5672/
RABBITMQ_EXCHANGE=examora.topic
RABBITMQ_ROUTING_KEY=ai.generate
RABBITMQ_QUEUE=ai.generation
RABBITMQ_DLX=examora.dlx
RABBITMQ_DLQ=ai.generation.dlq
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
RABBITMQ_CONSUMER_RESTART_BASE_DELAY_SECONDS=1
RABBITMQ_CONSUMER_RESTART_MAX_DELAY_SECONDS=30
RAW_UPLOAD_DIR=./data/raw
