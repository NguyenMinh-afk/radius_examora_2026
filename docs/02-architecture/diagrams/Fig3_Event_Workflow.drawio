        <mxCell id="outboxBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" value="OUTBOX PATTERN FLOW" vertex="1">
          <mxGeometry height="25" width="220" x="750" y="220" as="geometry" />
        </mxCell>
        <mxCell id="outboxContent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9673a6;fontSize=9;align=left;spacingLeft=10;fontFamily=Courier New;" value="1. Save entity + outbox event&#xa;   (same transaction)&#xa;&#xa;2. Outbox Processor reads&#xa;   pending events&#xa;&#xa;3. Publish to RabbitMQ&#xa;&#xa;4. Mark as PUBLISHED&#xa;   (or FAILED → retry)&#xa;&#xa;5. DLQ for failed messages" vertex="1">
          <mxGeometry height="130" width="220" x="750" y="245" as="geometry" />
        </mxCell>
        <mxCell id="outboxTable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" value="OUTBOX_EVENTS TABLE (infra_eventing schema)" vertex="1">
          <mxGeometry height="25" width="300" x="80" y="350" as="geometry" />
        </mxCell>
        <mxCell id="outboxTableContent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;fontFamily=Courier New;" value="┌───────────────────┬──────────────────────────┐&#xa;│ outbox_event_id   │ UUID (PK)                │&#xa;├───────────────────┼──────────────────────────┤&#xa;│ aggregate_type    │ VARCHAR(50)              │&#xa;│ aggregate_id      │ UUID                     │&#xa;│ event_type       │ VARCHAR(100)             │&#xa;│ payload          │ JSONB                    │&#xa;│ routing_key      │ VARCHAR(100)             │&#xa;│ status           │ PENDING/PUBLISHED/FAILED │&#xa;│ retry_count      │ INTEGER                  │&#xa;│ created_at       │ TIMESTAMP                │&#xa;│ published_at     │ TIMESTAMP                │&#xa;└───────────────────┴──────────────────────────┘" vertex="1">
          <mxGeometry height="150" width="300" x="80" y="375" as="geometry" />
        </mxCell>
        <mxCell id="queueJobsBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;fontStyle=1;fontSize=11;align=left;spacingLeft=10;" value="QUEUE_JOBS TABLE (infra_eventing schema)" vertex="1">
          <mxGeometry height="25" width="280" x="420" y="350" as="geometry" />
        </mxCell>
        <mxCell id="queueJobsContent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=9;align=left;spacingLeft=10;fontFamily=Courier New;" value="┌─────────────────┬──────────────────────────┐&#xa;│ queue_job_id    │ UUID (PK)                │&#xa;├─────────────────┼──────────────────────────┤&#xa;│ queue_name      │ VARCHAR(100)             │&#xa;│ payload         │ JSONB                    │&#xa;│ status          │ PENDING/PROCESSING/DONE │&#xa;│ attempts        │ INTEGER                  │&#xa;│ max_attempts    │ INTEGER                  │&#xa;│ scheduled_at    │ TIMESTAMP                │&#xa;│ processed_at    │ TIMESTAMP                │&#xa;│ error_message   │ TEXT                     │&#xa;└─────────────────┴──────────────────────────┘" vertex="1">
          <mxGeometry height="140" width="280" x="420" y="375" as="geometry" />
        </mxCell>
        <mxCell id="eventTypesBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=10;align=left;spacingLeft=10;" value="SUPPORTED EVENT TYPES" vertex="1">
          <mxGeometry height="22" width="180" x="750" y="400" as="geometry" />
