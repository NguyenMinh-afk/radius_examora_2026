        <mxCell id="msgContent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=10;fontFamily=Courier New;" value="{&#xa;  &quot;messageId&quot;: &quot;uuid&quot;,&#xa;  &quot;eventType&quot;: &quot;question.created&quot;,&#xa;  &quot;aggregateId&quot;: &quot;uuid&quot;,&#xa;  &quot;aggregateType&quot;: &quot;Question&quot;,&#xa;  &quot;payload&quot;: { ... },&#xa;  &quot;timestamp&quot;: &quot;ISO-8601&quot;,&#xa;  &quot;traceId&quot;: &quot;uuid&quot;&#xa;}" vertex="1">
