        <mxCell id="eventTypesContent" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#6c8ebf;fontSize=8;align=left;spacingLeft=10;fontFamily=Courier New;" value="user.*  → user.created, updated&#xa;question.* → created, updated&#xa;exam.*   → created, completed&#xa;ai.*     → generation.started,&#xa;           generation.completed&#xa;notification.* → new, read" vertex="1">
